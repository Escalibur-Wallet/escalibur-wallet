<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Todo arquivo do conteiner fica ilegivel com a tela bloqueada, inclusive o
	     que o sistema escreve pelo app (snapshots do seletor, caches). -->
	<key>com.apple.developer.default-data-protection</key>
	<string>NSFileProtectionComplete</string>
	<!-- A pasta dividida com o widget: so o arquivo do preco da ultima moeda vista ou
	     recebida (WidgetSnapshot), sem saldo, endereco nem carteira. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.app.escalibur.wallet</string>
	</array>
	<!-- Enhanced Security (Xcode 26), igual no widget: processo endurecido, versao e
	     restricoes de plataforma como string (as chaves inteiras impediam instalar no
	     iOS 18 com o iOS 17 de minimo), heap endurecido e dyld so de leitura. O
	     checked-allocations (MIE) so entra depois de testado num iPhone 17. -->
	<key>com.apple.security.hardened-process</key>
	<true/>
	<key>com.apple.security.hardened-process.enhanced-security-version-string</key>
	<string>1</string>
	<key>com.apple.security.hardened-process.platform-restrictions-string</key>
	<string>2</string>
	<key>com.apple.security.hardened-process.hardened-heap</key>
	<true/>
	<key>com.apple.security.hardened-process.dyld-ro</key>
	<true/>
</dict>
</plist>
