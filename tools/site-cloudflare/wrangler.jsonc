// O site da Escalibur Wallet na Cloudflare, em escaliburwallet.com (publicado pelo
// tools/publicar-site.sh, com o login do wrangler da conta do dominio).
{
  "name": "escalibur-site",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "../../build/site-dominio",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "escaliburwallet.com", "custom_domain": true },
    { "pattern": "www.escaliburwallet.com", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false }
}
