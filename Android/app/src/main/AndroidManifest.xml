<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- So rede e a biometria do sistema. Nenhuma outra permissao: sem contatos, sem localizacao,
         sem armazenamento. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- Sem backup (nem do Google nem de aparelho para aparelho): as chaves ficam so neste
         aparelho, como no iOS. Sem trafego em texto puro. -->
    <application
        android:name=".EscaliburApp"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/sem_backup"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/rede"
        android:label="Escalibur Wallet"
        android:supportsRtl="true"
        android:theme="@style/Tema.Escalibur">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
